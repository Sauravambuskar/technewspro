# Copy to .env.local. On Vercel, run `vercel env pull .env.local --yes` instead —
# the Neon Marketplace integration injects DATABASE_URL automatically.

# Postgres connection string (provided by the Neon integration). Required.
DATABASE_URL=

# Seeds the first admin account the very first time the users collection is created.
# Changing these later does NOT change an existing account; use Admin -> Team instead.
ADMIN_EMAIL=admin@salesinfopro.com
ADMIN_PASSWORD=changeme123

# Signs admin session cookies. If unset, a random secret is generated once and
# stored in the database. Set it explicitly in production so sessions survive
# even if the secret row is ever recreated.
ADMIN_SESSION_SECRET=
