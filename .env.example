# Copy to .env.local. In production, set these in the Vercel project's
# Environment Variables settings (Settings -> Environment Variables).

# MySQL connection string, e.g. mysql://user:password@host:3306/database.
# Percent-encode special characters in the password (@ -> %40, etc). Required.
DATABASE_URL=

# Seeds the first admin account the very first time the users collection is created.
# Changing these later does NOT change an existing account; use Admin -> Team instead.
ADMIN_EMAIL=admin@technewspro.com
ADMIN_PASSWORD=changeme123

# Signs admin session cookies. If unset, a random secret is generated once and
# stored in the database. Set it explicitly in production so sessions survive
# even if the secret row is ever recreated.
ADMIN_SESSION_SECRET=

# Transactional email (optional). Without RESEND_API_KEY nothing is ever sent,
# and every form on the site keeps working exactly as it does now.
RESEND_API_KEY=
# Sender address. Needs a domain verified in Resend; the default shared sender
# (onboarding@resend.dev) only delivers to the Resend account owner.
EMAIL_FROM=
