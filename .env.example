# Copy to .env.local and adjust. Everything here is optional — the site runs without it.

# Seeds the first admin account the very first time data/users.json is created.
# Changing these later does NOT change an existing account; use Admin → Team instead.
ADMIN_EMAIL=admin@technewsinfopro.com
ADMIN_PASSWORD=changeme123

# Signs admin session cookies. If unset, a random secret is generated once and
# stored in data/secret.json. Set it explicitly in production, or on any host with
# an ephemeral filesystem, so sessions survive redeploys.
ADMIN_SESSION_SECRET=
